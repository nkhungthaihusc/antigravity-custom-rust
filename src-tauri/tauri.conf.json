{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Custom",
  "version": "0.5.0",
  "identifier": "local.antigravity.custom",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Antigravity Custom",
        "width": 1120,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icon.ico"
    ]
  }
}
