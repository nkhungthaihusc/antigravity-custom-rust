{
  "name": "antigravity-custom",
  "version": "0.5.0",
  "private": true,
  "description": "High-performance Rust launcher, native splash and theme customization for Antigravity App",
  "author": "Antigravity Custom contributors",
  "license": "MIT",
  "scripts": {
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "build": "cargo build --manifest-path src-tauri/Cargo.toml --release",
    "build:cli": "cargo build --manifest-path crates/agc-core/Cargo.toml --release",
    "test": "node --test test/*.test.cjs",
    "test:rust": "cargo test --manifest-path crates/agc-core/Cargo.toml",
    "check": "node scripts/check.cjs",
    "audit:media": "node scripts/audit-media.cjs",
    "package": "node scripts/package.cjs",
    "verify:portable": "node scripts/verify-portable.cjs",
    "native:install": "node scripts/native-install.cjs install",
    "native:uninstall": "node scripts/native-install.cjs uninstall"
  }
}
